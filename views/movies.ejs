<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Netflix Clone - Movies</title>
  <link rel="icon" type="image/png" href="/assets/image/logo/favicon.png">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }
    body {
      background: #000;
      color: #fff;
    }
    .container {
      padding: 40px 60px;
      margin-top: 5vw;
    }
    .empty {
      text-align: center;
      color: #aaa;
      font-size: 18px;
    }
    .movie-table {
      width: 100%;
      border-collapse: collapse;
      background: #111;
      border-radius: 10px;
      overflow: hidden;
    }
    .movie-table th, .movie-table td {
      padding: 15px;
    }
    .movie-table thead {
      background: #1a1a1a;
    }
    .movie-table th {
      font-size: 14px;
      text-align: center;
      color: #ccc;
    }
    .movie-table tbody tr {
      border-bottom: 1px solid #222;
      transition: 0.2s;
    }
    tr td {
      text-align: center;
    }
    .movie-table tbody tr:hover {
      background: #1f1f1f;
    }
    .poster {
      width: 60px;
      border-radius: 5px;
    }
    .edit {
      color: #000;
      background: #feca57;
      padding: 5px 12px;
      border-radius: 4px;
      text-decoration: none;
      margin-right: 6px;
      font-size: 13px;
      font-weight: bold;
    }
    .edit:hover {
      background: #f9ca24;
    }
    .delete {
      color: #fff;
      background: #ff6b6b;
      padding: 5px 12px;
      border-radius: 4px;
      border: none;
      font-size: 13px;
      font-weight: bold;
      cursor: pointer;
    }
    .delete:hover {
      background: #ee5a24;
    }
  </style>
</head>
<body>

<%- include('header') %>

<div class="container">

  <% if (!movies || movies.length === 0) { %>
    <p class="empty">No movies available</p>
  <% } else { %>

    <table class="movie-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Poster</th>
          <th>Title</th>
          <th>Year</th>
          <th>Category</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <% movies.forEach((movie, index) => { %>
          <tr>
            <td><%= index + 1 %></td>

            <td>
              <img src="<%= movie.poster || '/assets/image/no-image.png' %>" class="poster" alt="<%= movie.title %>" />
            </td>

            <td><%= movie.title %></td>
            <td><%= movie.year %></td>
            <td>
              <% if (movie.genre) { %>
                <%= Array.isArray(movie.genre) ? movie.genre.join(', ') : movie.genre %>
              <% } else if (movie.category) { %>
                <%= movie.category %>
              <% } else { %>
                N/A
              <% } %>
            </td>

            <td>
              <a href="/edit/<%= movie._id %>" class="edit">Edit</a>
              <button onclick="deleteMovie('<%= movie._id %>')" class="delete">Delete</button>
            </td>
          </tr>
        <% }) %>
      </tbody>

    </table>

  <% } %>

</div>

<%- include('footer') %>

<script>
function deleteMovie(id) {
  if (confirm('Are you sure you want to delete this movie?')) {
    fetch('/movies/' + id, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('Delete failed: ' + data.error);
      }
    })
    .catch(err => {
      alert('Error: ' + err.message);
    });
  }
}
</script>

</body>
</html>