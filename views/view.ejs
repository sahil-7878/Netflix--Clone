<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= movie.title || "Movie" %></title>
  <link rel="stylesheet" href="/assets/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Poppins', sans-serif;
    }

    body {
      background: #0f0f0f;
      color: #fff;
      min-height: 100vh;
    }

    .main {
      padding: 100px 40px 60px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .card {
      display: flex;
      gap: 50px;
      background: rgba(255,255,255,0.04);
      border-radius: 20px;
      padding: 45px 40px;
      backdrop-filter: blur(15px);
      box-shadow: 0 0 30px rgba(0,0,0,0.6);
      flex-wrap: wrap;
    }

    /* ----- POSTER ----- */
    .poster {
      width: 280px;
      border-radius: 15px;
      transition: 0.3s;
      object-fit: cover;
      flex-shrink: 0;
    }

    .poster:hover {
      transform: scale(1.03);
    }

    /* ----- INFO ----- */
    .info {
      flex: 1;
      min-width: 250px;
    }

    .title {
      font-size: 2.8rem;
      font-weight: 700;
      margin-bottom: 8px;
      line-height: 1.2;
    }

    .tags {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 12px;
    }

    .tag {
      background: #ff4757;
      padding: 4px 16px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 500;
    }

    .meta {
      color: #bbb;
      margin-bottom: 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      font-size: 14px;
    }

    .meta .rating {
      color: #ffd700;
      font-weight: 600;
    }

    .desc {
      line-height: 1.8;
      color: #ccc;
      margin-bottom: 25px;
      font-size: 15px;
    }

    /* ----- GRID ----- */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 12px;
    }

    .box {
      background: rgba(0,0,0,0.35);
      padding: 14px 16px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.04);
    }

    .box h4 {
      font-size: 11px;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 4px;
    }

    .box p,
    .box .chip {
      font-size: 14px;
      font-weight: 500;
      color: #fff;
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .chip {
      background: rgba(255,255,255,0.06);
      padding: 3px 12px;
      border-radius: 20px;
      font-size: 12px;
    }

    .rating-big {
      margin-top: 18px;
      font-size: 20px;
      color: #ffd700;
      font-weight: 700;
    }

    /* ----- BUTTONS ----- */
    .btn-group {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 25px;
    }

    .btn-group .btn {
      padding: 10px 28px;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn-edit {
      background: #feca57;
      color: #000;
    }

    .btn-edit:hover {
      background: #f9ca24;
      transform: scale(1.02);
    }

    .btn-delete {
      background: #ff6b6b;
      color: #fff;
    }

    .btn-delete:hover {
      background: #ee5a24;
      transform: scale(1.02);
    }

    .btn-back {
      background: rgba(255,255,255,0.06);
      color: #fff;
      border: 1px solid rgba(255,255,255,0.06);
    }

    .btn-back:hover {
      background: rgba(255,255,255,0.12);
    }

    /* ============================================
       RESPONSIVE
       ============================================ */

    /* Tablet */
    @media (max-width: 992px) {
      .main {
        padding: 90px 30px 40px;
      }

      .card {
        padding: 35px 30px;
        gap: 35px;
      }

      .poster {
        width: 220px;
      }

      .title {
        font-size: 2.2rem;
      }

      .grid {
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      }
    }

    /* Mobile */
    @media (max-width: 768px) {
      .main {
        padding: 80px 18px 30px;
      }

      .card {
        flex-direction: column;
        align-items: center;
        padding: 30px 20px;
        gap: 25px;
        text-align: center;
      }

      .poster {
        width: 200px;
      }

      .title {
        font-size: 1.8rem;
        text-align: center;
      }

      .tags {
        justify-content: center;
      }

      .meta {
        justify-content: center;
        font-size: 13px;
      }

      .desc {
        text-align: center;
        font-size: 14px;
      }

      .grid {
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        justify-items: center;
      }

      .box {
        text-align: center;
        width: 100%;
      }

      .chips {
        justify-content: center;
      }

      .rating-big {
        text-align: center;
      }

      .btn-group {
        justify-content: center;
      }

      .btn-group .btn {
        padding: 8px 20px;
        font-size: 13px;
      }
    }

    /* Small Mobile */
    @media (max-width: 480px) {
      .main {
        padding: 70px 12px 20px;
      }

      .card {
        padding: 20px 14px;
        gap: 18px;
        border-radius: 14px;
      }

      .poster {
        width: 150px;
      }

      .title {
        font-size: 1.4rem;
      }

      .meta {
        font-size: 12px;
        gap: 10px;
      }

      .desc {
        font-size: 13px;
      }

      .grid {
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }

      .box {
        padding: 10px 12px;
      }

      .box h4 {
        font-size: 10px;
      }

      .box p,
      .box .chip {
        font-size: 12px;
      }

      .rating-big {
        font-size: 17px;
      }

      .btn-group .btn {
        padding: 6px 16px;
        font-size: 12px;
      }
    }

    /* Very Small Mobile */
    @media (max-width: 360px) {
      .poster {
        width: 120px;
      }

      .title {
        font-size: 1.2rem;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .btn-group .btn {
        width: 100%;
        justify-content: center;
      }
    }
  </style>
</head>
<body>

<%- include('header') %>

<%
  let genres = Array.isArray(movie.genre) ? movie.genre : (movie.genre || "").split(",");
  let directors = Array.isArray(movie.director) ? movie.director : (movie.director || "").split(",");
%>

<div class="main">
  <div class="card">

    <!-- Poster -->
    <img src="<%= movie.poster || '/assets/image/no-image.png' %>" class="poster" alt="<%= movie.title %>">

    <!-- Info -->
    <div class="info">

      <h1 class="title"><%= movie.title %></h1>

      <div class="tags">
        <% genres.forEach(g => { if(g.trim()) { %>
          <span class="tag"><%= g.trim() %></span>
        <% } }) %>
      </div>

      <div class="meta">
        <span>📅 <%= movie.year %></span>
        <span>⏱ <%= movie.duration %> min</span>
        <span class="rating">⭐ <%= movie.rating || "N/A" %></span>
      </div>

      <p class="desc"><%= movie.description %></p>

      <!-- Grid -->
      <div class="grid">

        <div class="box">
          <h4>Director</h4>
          <div class="chips">
            <% directors.forEach(d => { if(d.trim()) { %>
              <span class="chip"><%= d.trim() %></span>
            <% } }) %>
          </div>
        </div>

        <div class="box">
          <h4>Genre</h4>
          <div class="chips">
            <% genres.forEach(g => { if(g.trim()) { %>
              <span class="chip"><%= g.trim() %></span>
            <% } }) %>
          </div>
        </div>

        <div class="box">
          <h4>Year</h4>
          <p><%= movie.year %></p>
        </div>

        <div class="box">
          <h4>Duration</h4>
          <p><%= movie.duration %> min</p>
        </div>

      </div>

      <div class="rating-big">
        ⭐ <%= movie.rating || "N/A" %> / 10
      </div>

      <!-- Buttons -->
      <div class="btn-group">
        <a href="/edit/<%= movie._id %>" class="btn btn-edit">✏️ Edit</a>
        <button onclick="deleteMovie('<%= movie._id %>')" class="btn btn-delete">🗑️ Delete</button>
        <a href="/movies" class="btn btn-back">⬅ Back</a>
      </div>

    </div>
  </div>
</div>

<%- include('footer') %>

<script>
function deleteMovie(id) {
  if (confirm('Are you sure you want to delete this movie?')) {
    fetch('/movies/' + id, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        window.location.href = '/movies';
      } else {
        alert('Delete failed: ' + data.error);
      }
    })
    .catch(err => {
      alert('Error: ' + err.message);
    });
  }
}
</script>

</body>
</html>
